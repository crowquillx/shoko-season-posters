<Project>
  <PropertyGroup>
    <!-- The follow-shoko-daily workflow bumps these two lines when Shoko publishes new builds. -->
    <ShokoAbstractionsVersion>6.0.0-alpha.143</ShokoAbstractionsVersion>
    <ShokoBuildToolsTargetsVersion>0.8.1</ShokoBuildToolsTargetsVersion>
    <!-- The Magick.NET version the server ships, which the plugin borrows at runtime. -->
    <MagickNetVersion>14.17.1</MagickNetVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
