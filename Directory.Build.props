<Project>
  <PropertyGroup>
    <!-- The follow-shoko-daily workflow bumps these two lines when Shoko publishes new builds. -->
    <ShokoAbstractionsVersion>6.0.0-alpha.131</ShokoAbstractionsVersion>
    <ShokoBuildToolsTargetsVersion>0.8.0</ShokoBuildToolsTargetsVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
